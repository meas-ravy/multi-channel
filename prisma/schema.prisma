generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AutomationTrigger {
  MESSAGE
  COMMENT
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

model FacebookPage {
  id                   String   @id @default(cuid())
  metaPageId           String   @unique @map("meta_page_id")
  name                 String
  accessTokenEncrypted String   @db.Text @map("access_token_encrypted")
  tasks                String[] @default([])
  connectedAt          DateTime @default(now()) @map("connected_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  automations          Automation[]
  webhookEvents        WebhookEvent[]
  messengerFlow        MessengerFlow?
  messengerSessions    MessengerSession[]

  @@map("facebook_pages")
}

model MessengerFlow {
  id             String       @id @default(cuid())
  facebookPageId String       @unique @map("facebook_page_id")
  draft          Json
  published      Json?
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)

  @@map("messenger_flows")
}

model MessengerSession {
  id             String       @id @default(cuid())
  facebookPageId String       @map("facebook_page_id")
  senderId       String       @map("sender_id")
  waitingNodeId  String?      @map("waiting_node_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)

  @@unique([facebookPageId, senderId])
  @@map("messenger_sessions")
}

model Automation {
  id             String            @id @default(cuid())
  facebookPageId String            @map("facebook_page_id")
  name           String
  trigger        AutomationTrigger
  keyword        String
  replyText      String            @db.Text @map("reply_text")
  isActive       Boolean           @default(true) @map("is_active")
  priority       Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  facebookPage   FacebookPage      @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)

  @@index([facebookPageId, trigger, isActive])
  @@map("automations")
}

model WebhookEvent {
  id             String             @id @default(cuid())
  eventKey       String             @unique @map("event_key")
  metaPageId     String             @map("meta_page_id")
  facebookPageId String?            @map("facebook_page_id")
  eventType      AutomationTrigger  @map("event_type")
  payload        Json
  status         WebhookEventStatus @default(RECEIVED)
  error          String?            @db.Text
  receivedAt     DateTime           @default(now()) @map("received_at")
  processedAt    DateTime?          @map("processed_at")
  facebookPage   FacebookPage?      @relation(fields: [facebookPageId], references: [id], onDelete: SetNull)

  @@index([metaPageId, receivedAt])
  @@index([status, receivedAt])
  @@map("webhook_events")
}
