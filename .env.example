DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chart_automation"
# Direct/unpooled URL used by Prisma migrations in deployment environments.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/chart_automation"

# The OAuth redirect must match exactly in Meta.
META_REDIRECT_URI="http://localhost:3000/api/meta/callback"

# Meta App Dashboard values. Never expose these with a NEXT_PUBLIC_ prefix.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="vXX.X"
META_WEBHOOK_VERIFY_TOKEN=""

# Generate with: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=""
ADMIN_API_KEY=""
